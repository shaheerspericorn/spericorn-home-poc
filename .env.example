# Backend
PORT=4000
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/models
MAX_UPLOAD_SIZE_MB=100
SUPPORTED_SOURCE_FORMATS=dwg,ifc,rvt,step,stp
# local:  2D DWG/DXF -> ODA File Converter -> ezdxf -> rule-based detection -> trimesh -> GLB (no cloud, no APS keys).
# aps:    Autodesk Platform Services for real 3D CAD/BIM -> GLB conversion (rejects 2D drawings).
# sample: built-in Sample Villa GLB; the uploaded file is NOT converted (frontend development only).
CAD_CONVERSION_PROVIDER=local

# ---- Local 2D pipeline (CAD_CONVERSION_PROVIDER=local) -------------------------------------
# Absolute path to the ODA File Converter executable. Leave empty to auto-detect
# (PATH, /usr/bin/ODAFileConverter, ~/.local/share/oda/squashfs-root/AppRun, Program Files\ODA, /Applications).
ODA_FILE_CONVERTER_PATH=
# Per-job working directories (DXF + analysis.json) and generated GLBs. Relative to backend/.
CAD_WORK_DIR=./data/cad-work
# Overrides OUTPUT_DIR when set.
CAD_OUTPUT_DIR=
# Python interpreter of the CAD worker. Leave empty for ../cad-worker/.venv/bin/python.
CAD_PYTHON_PATH=
CAD_WORKER_DIR=../cad-worker
CAD_WORKER_TIMEOUT_MS=300000
CAD_CONVERTER_TIMEOUT_SEC=180
LOCAL_SUPPORTED_FORMATS=dwg,dxf
# Optional: JSON file with layer/block patterns and tolerances (default: cad-worker/config/detection.default.json).
CAD_DETECTION_CONFIG=
# Optional: force drawing units (millimeters|centimeters|meters|inches|feet) when the DWG header is wrong.
CAD_UNITS_OVERRIDE=

# A 2D plan has no heights: these are the assumptions used for 3D reconstruction (metres).
DEFAULT_WALL_HEIGHT_M=3
DEFAULT_WALL_THICKNESS_M=0.20
DEFAULT_FLOOR_THICKNESS_M=0.15
DEFAULT_DOOR_HEIGHT_M=2.1
DEFAULT_WINDOW_SILL_M=0.9
DEFAULT_WINDOW_HEAD_M=2.1

# Logs the Python worker's stderr in the backend console.
DEBUG_CAD=true

# ---- APS (CAD_CONVERSION_PROVIDER=aps) ------------------------------------------------------
APS_POLL_INTERVAL_MS=3000
APS_REGION=US

# Create an APS app at https://aps.autodesk.com/myapps.
# Required only when CAD_CONVERSION_PROVIDER=aps. Do not expose these values to the frontend.
APS_CLIENT_ID=
APS_CLIENT_SECRET=
# Must be globally unique, lowercase, 3-128 characters. Leave empty to derive one
# from your APS client id in development.
APS_BUCKET_KEY=

# ---- Frontend viewer (put these in frontend/.env; all optional) --------------------------------
# Camera transition length in ms (500-1000 feels right) and how much air to leave around a focused room
# (1 = the room's bounding sphere exactly fills the view). All other framing tunables: frontend/lib/camera-framing.ts
# NEXT_PUBLIC_CAMERA_TRANSITION_MS=700
# NEXT_PUBLIC_ROOM_CAMERA_DISTANCE_MULTIPLIER=1.7
